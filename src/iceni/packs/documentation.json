{
  "name": "documentation",
  "description": "Write the docs nobody wants to write.",
  "aliases": [
    {
      "petname": "docstring",
      "intent": {
        "goal": "Write a Google-style docstring for this function.",
        "inputs": [
          "{{code}}"
        ],
        "constraints": [
          "be concise",
          "cite line numbers where relevant"
        ],
        "outputs": {
          "format": "docstring only"
        },
        "style_hints": {
          "claude": "XML-tagged sections around fenced code blocks",
          "gpt": "markdown with fenced code blocks",
          "kimi": "code first, minimal prose"
        }
      }
    },
    {
      "petname": "readme",
      "intent": {
        "goal": "Draft a README for this project/module.",
        "inputs": [
          "{{code}}"
        ],
