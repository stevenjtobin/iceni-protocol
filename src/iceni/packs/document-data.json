{
  "name": "document-data",
  "description": "Wrangle documents and messy text.",
  "aliases": [
    {
      "petname": "extract-fields",
      "intent": {
        "goal": "Extract the structured fields from this text as JSON.",
        "inputs": [
          "{{input}}"
        ],
        "constraints": [
          "one row per item",
          "rank by importance"
        ],
        "outputs": {
          "format": "JSON object"
        },
        "style_hints": {
          "claude": "XML rows with attributes",
          "gpt": "markdown table",
          "kimi": "compact list, highest-priority first"
        }
      }
    },
    {
      "petname": "table-from-text",
      "intent": {
        "goal": "Turn this unstructured text into a table.",
        "inputs": [
          "{{input}}"
        ],
        "constraints": [
          "one row per item",
          "rank by importance"
        ],
        "outputs": {
          "format": "markdown table"
