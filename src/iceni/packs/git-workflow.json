{
  "name": "git-workflow",
  "description": "Everything around the commit.",
  "aliases": [
    {
      "petname": "commit-message",
      "intent": {
        "goal": "Write a conventional commit message for this git diff.",
        "inputs": [
          "{{input}}"
        ],
        "constraints": [
          "be concise",
          "cite line numbers where relevant"
        ],
        "outputs": {
          "format": "subject + optional body"
        },
        "style_hints": {
          "claude": "XML-tagged sections around fenced code blocks",
          "gpt": "markdown with fenced code blocks",
          "kimi": "code first, minimal prose"
        }
      }
    },
    {
      "petname": "pr-description",
      "intent": {
        "goal": "Write a PR description from this diff.",
