      "petname": "decision-matrix",
      "intent": {
        "goal": "Build a weighted decision matrix for these options.",
        "inputs": [
          "{{input}}"
        ],
        "constraints": [
          "one row per item",
          "rank by importance"
        ],
        "outputs": {
          "format": "scored matrix + winner"
        },
        "style_hints": {
          "claude": "XML rows with attributes",
          "gpt": "markdown table",
          "kimi": "compact list, highest-priority first"
        }
      }
