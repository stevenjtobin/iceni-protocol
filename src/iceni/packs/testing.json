{
  "name": "testing",
  "description": "Generate and review tests.",
  "aliases": [
    {
      "petname": "test-gen",
      "intent": {
        "goal": "Write unit tests for this function.",
        "inputs": [
          "{{code}}"
        ],
        "constraints": [
          "be concise",
          "cite line numbers where relevant"
        ],
        "outputs": {
          "format": "runnable pytest code"
        },
        "style_hints": {
          "claude": "XML-tagged sections around fenced code blocks",
          "gpt": "markdown with fenced code blocks",
          "kimi": "code first, minimal prose"
        }
      }
    },
    {
      "petname": "edge-cases",
      "intent": {
        "goal": "List the edge cases this code must handle.",
        "inputs": [
