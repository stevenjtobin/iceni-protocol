{
  "name": "code-quality-plus",
  "description": "Deep code-quality reviews (the proven structure-heavy winners + more).",
  "aliases": [
    {
      "petname": "review",
      "intent": {
        "goal": "Review this code for bugs, edge cases, and security issues.",
        "inputs": [
          "{{code}}"
        ],
        "constraints": [
          "be concise",
          "cite line numbers where relevant"
        ],
        "outputs": {
          "format": "issues grouped by severity"
        },
        "style_hints": {
          "claude": "XML-tagged sections around fenced code blocks",
          "gpt": "markdown with fenced code blocks",
          "kimi": "code first, minimal prose"
        }
      }
    },
    {
      "petname": "security-audit",
      "intent": {
