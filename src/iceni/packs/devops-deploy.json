      "intent": {
        "goal": "Check this code for production readiness before deployment.",
        "inputs": [
          "{{input}}"
        ],
        "constraints": [
          "be concise",
          "cite line numbers where relevant"
        ],
        "outputs": {
          "format": "PASS/FAIL/WARN checklist"
        },
        "style_hints": {
          "claude": "XML-tagged sections around fenced code blocks",
