{
  "name": "debugging",
  "description": "Find and fix what's broken.",
  "aliases": [
    {
      "petname": "error-explain",
      "intent": {
        "goal": "Explain this error and give the exact fix.",
        "inputs": [
          "{{input}}"
        ],
        "constraints": [
          "be concise",
          "cite line numbers where relevant"
        ],
        "outputs": {
          "format": "root cause + corrected code"
        },
        "style_hints": {
          "claude": "XML-tagged sections around fenced code blocks",
          "gpt": "markdown with fenced code blocks",
          "kimi": "code first, minimal prose"
        }
      }
    },
    {
      "petname": "stack-trace",
      "intent": {
        "goal": "Read this stack trace and pinpoint the cause.",
        "inputs": [
          "{{input}}"
        ],
        "constraints": [
          "be concise",
          "cite line numbers where relevant"
        ],
        "outputs": {
          "format": "cause + fix location"
        },
        "style_hints": {
          "claude": "XML-tagged sections around fenced code blocks",
          "gpt": "markdown with fenced code blocks",
          "kimi": "code first, minimal prose"
        }
      }
    },
    {
      "petname": "root-cause",
      "intent": {
        "goal": "Do a root-cause analysis of this bug.",
        "inputs": [
          "{{input}}"
        ],
        "constraints": [
          "be concise",
          "cite line numbers where relevant"
        ],
        "outputs": {
          "format": "5-whys + root cause"
        },
        "style_hints": {
          "claude": "XML-tagged sections around fenced code blocks",
          "gpt": "markdown with fenced code blocks",
          "kimi": "code first, minimal prose"
        }
      }
    },
    {
      "petname": "repro-steps",
