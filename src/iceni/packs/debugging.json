          "{{input}}"
        ],
        "constraints": [
          "be concise",
          "cite line numbers where relevant"
        ],
        "outputs": {
          "format": "numbered repro steps"
        },
        "style_hints": {
          "claude": "XML-tagged sections around fenced code blocks",
