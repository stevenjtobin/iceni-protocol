{
  "name": "lang-tools",
  "description": "Targeted language and tooling helpers.",
  "aliases": [
    {
      "petname": "regex-explain",
      "intent": {
        "goal": "Explain this regex and flag any bugs.",
        "inputs": [
          "{{input}}"
        ],
        "constraints": [
          "be concise",
          "cite line numbers where relevant"
        ],
        "outputs": {
          "format": "explanation + issues"
        },
        "style_hints": {
          "claude": "XML-tagged sections around fenced code blocks",
          "gpt": "markdown with fenced code blocks",
          "kimi": "code first, minimal prose"
        }
      }
    },
